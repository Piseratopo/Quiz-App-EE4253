# Local MongoDB: install MongoDB Community Server and leave this value as-is.
# Atlas: replace with the connection string supplied by Atlas.
MONGODB_URI=mongodb://localhost:27017/quiz_app

# Optional when the URI has no database name, e.g. a MongoDB Atlas URI.
# MONGODB_DB_NAME=quiz_app

# Generate a long random value before deploying.
JWT_SECRET=replace-with-a-long-random-secret
